# Copy to .env and fill values. Never commit .env
#   cp .env.example .env

# 所有 WebUI 可编辑配置都使用 .env 覆盖 config/*.py 默认值。

# ---- WebUI 授权 ----
# WebUI 登录授权码；仅保存在 .env，避免出现在进程命令行中
WEBUI_AUTH_CODE=
# 可选：Session Cookie 签名密钥；留空时从固定授权码派生，修改授权码会使已有登录失效
WEBUI_SESSION_SECRET=


# ---- 功能开关 ----
# 启用 Codex OAuth: 注册成功后自动跑 Codex 授权（全新session+接码），落盘 codex-邮箱.json
ENABLE_CODEX_AUTO=

# ---- 注册方式 ----
# 注册驱动: protocol=纯协议（curl_cffi）；cloak=CloakBrowser 本地指纹浏览器（原 roxy/patchright/browser_use/skyvern 已移除）
REGISTRATION_DRIVER=

# ---- CloakBrowser ----
# Cloak无头: True=无头运行；False=显示浏览器窗口
CLOAK_HEADLESS=
# Cloak人工行为: 启用 CloakBrowser humanize 鼠标/键盘/滚动行为
CLOAK_HUMANIZE=
# Cloak按出口定位: 按当前出口 IP 自动匹配时区/语言/WebRTC IP；支持显式代理、系统代理/VPN
CLOAK_GEOIP=
# Cloak语言: 留空自动；日本可填 ja-JP，美国 en-US
CLOAK_LOCALE=
# Cloak时区: 留空自动；日本可填 Asia/Tokyo，美国 America/Los_Angeles
CLOAK_TIMEZONE=
# Cloak使用代理: 把本项目传入或代理池抽取的代理传给 CloakBrowser
CLOAK_USE_PROXY=
# Cloak License: Pro license；留空使用免费 binary
CLOAK_LICENSE_KEY=
# Cloak指纹Seed: 留空每次随机；固定值可保持同一指纹
CLOAK_FINGERPRINT_SEED=
# Cloak用户目录: 留空使用临时上下文；填写路径则持久化 cookies/cache
CLOAK_USER_DATA_DIR=
# Cloak超时: 页面和元素等待超时时间，秒
CLOAK_SELENIUM_TIMEOUT=
# 保留Cloak浏览器: 调试时开启，任务结束后不自动关闭
CLOAK_KEEP_BROWSER_OPEN=
# Codex回调超时: Cloak Codex OAuth 等待 localhost:1455 callback 的最长秒数
CLOAK_CODEX_CALLBACK_TIMEOUT=

# ---- CPA / Codex ----
# Codex授权驱动: platform=免接码platform OAuth；protocol=原协议授权；cloak=用 CloakBrowser；same_as_registration=跟随 REGISTRATION_DRIVER
CODEX_OAUTH_DRIVER=

# ---- 功能开关 ----
# 启用 2FA(TOTP): 注册完成后自动设置动态口令（会多收一封 OTP 邮件）
ENABLE_2FA=
# 2FA 重认证发起阶段最大尝试次数（403/429/5xx/网络错误时重试）
TWOFA_REAUTH_MAX_ATTEMPTS=
# 2FA 重认证重试基础间隔秒数（按 1、2、4 倍指数退避）
TWOFA_REAUTH_RETRY_DELAY=
# 2FA 后台任务并发数（修改后需重启服务）
TWOFA_WORKERS=
# 2FA 后台等待队列容量
TWOFA_QUEUE_LIMIT=
# 启用 Flow 触发: 注册成功后自动调用内部 Flow 接口（不影响注册结果）
ENABLE_FLOW_TRIGGER=

# ---- 人工节奏 ----
# 启用随机停顿: 在注册、OTP、授权等步骤之间加入随机等待，更接近人工操作节奏
ENABLE_HUMANIZE_DELAY=
# 停顿倍率: 随机停顿整体倍率；1.0=默认，0.5=减半，2.0=加倍
HUMANIZE_DELAY_FACTOR=

# ---- 邮箱 / OTP ----
# 自动取邮箱+收码: True=从邮箱池自动领邮箱并自动收 OTP；False=手动模式：用 REGISTER_EMAIL，OTP 在任务页手填
USE_EMAIL_SERVICE=
# 手动注册邮箱: USE_EMAIL_SERVICE=False 时必填。例如你的 outlook.com 地址；OTP 去网页邮箱看，再回任务页提交
REGISTER_EMAIL=
# 密码注册: True=带密码注册（注册后账号可密码重登，密码存 extra_json.registration_password）；False=纯 OTP 无密码注册
REGISTER_WITH_PASSWORD=
# 注册密码: 密码注册使用的固定密码；留空则每个账号随机生成强密码
REGISTER_PASSWORD=
# 显示名称: 留空则自动生成英文名
REGISTER_NAME=
# OTP 最长等待(秒): 等待验证码邮件的最长秒数，超时判失败
OTP_MAX_WAIT=
# OTP 轮询间隔(秒): 每隔多少秒查一次新邮件
OTP_POLL_INTERVAL=
# 邮箱来源: 精简版只支持 outlook（外购 Outlook 账号池 + mail.chatai.codes 远端取信）
EMAIL_SOURCE=
# Outlook取件模式: auto=远端优先，远端 402/DEPLOYMENT_DISABLED 自动切 Graph 直连；direct=只用 Microsoft Graph 直连；remote=只用远端服务
OUTLOOK_FETCH_MODE=

# ---- 浏览器画像 ----
# 地区画像: 应与代理出口地区一致；可选 jp/cn/us/sg。当前本地代理实测为日本东京，推荐 jp
BROWSER_LOCALE_PROFILE=
# 按出口IP自动画像: 开启后每个 BrowserSession 会用当前代理出口 IP 自动选择语言/时区；失败时回退到地区画像
AUTO_BROWSER_LOCALE_FROM_IP=
# IP定位超时(秒): 出口 IP 地理信息接口的单次请求超时；接口失败会自动回退，不影响注册
IP_GEO_TIMEOUT=
# Cloak 本地浏览器省流量模式: True=拦截图片/媒体等可选资源；默认 False
BROWSER_DATA_SAVER_MODE=
# 省流量拦截类型: 每行一种；未填写默认 image、media，也可填 stylesheet/font/manifest/texttrack；填 [] 可关闭
BROWSER_DATA_SAVER_BLOCKED_RESOURCE_TYPES=
# 省流量 URL glob: 每行一条；未填写使用内置 RUM/广告统计/Google GSI 规则，填 [] 可关闭 URL 规则
BROWSER_DATA_SAVER_BLOCKED_URL_PATTERNS=
# Cloak 本地浏览器资源明细日志: True=注册结束输出每个资源的 URL/类型/状态/上传下载大小；默认 False
BROWSER_TRAFFIC_DETAIL_LOG=
# 明细日志最多输出的资源条数（按单请求总字节降序）
BROWSER_TRAFFIC_DETAIL_MAX_ENTRIES=
# Cloak 本地浏览器 JS 精确覆盖率日志: True=记录实际执行的 JS 函数/offset；默认 False
BROWSER_JS_COVERAGE_LOG=
# JS 函数日志最多输出条数；同时限制保存到 network_traffic 的脚本摘要数量
BROWSER_JS_COVERAGE_MAX_ENTRIES=

# ---- 代理池 ----
# 代理池(每行一个): 每行一个代理 URL，留空行会被忽略；为空则不使用代理
# 粘性住宅代理占位符(每次注册展开,同一次注册全程同 IP):
#   {sid}   → 随机 8 位会话 ID,一号一 IP:
#             http://user-region-US-sid-{sid}:pass@gw.provider.com:8000
#   {email} → URL 转义后的邮箱(@ → %40),与 gpt-account-hub 注入规则一致,
#             同一邮箱注册与使用两侧同出口:
#             socks5h://my.{email}:Password4!@resin.example.com:5178
# 注意: cloak 通道需用 http(s) 形式(Chromium 不支持 SOCKS5 认证);
#       协议通道支持 socks5h。手动模式 + {email} 需先确定邮箱。
PROXY_POOL=
# 套餐查询网络模式: auto=本地代理可用则使用、未监听则直连；proxy=强制代理；direct=强制直连
PLAN_CHECK_PROXY_MODE=
# 套餐查询专用代理: 留空时 auto/proxy 从代理池选择；可能包含认证信息
PLAN_CHECK_PROXY=

# ---- CPA / Codex ----
# 授权地址来源: cpa=由 CPA 管理接口生成授权地址；local=旧版本地生成 PKCE 授权地址
CODEX_AUTH_URL_SOURCE=
# CPA 管理地址: 例如 http://localhost:8317/admin/oauth；程序会取 origin 调用 /v0/management/*
CPA_MANAGEMENT_URL=
# 管理密钥: 保存在 .env（CPA_MANAGEMENT_KEY），不写回 config/*.py
CPA_MANAGEMENT_KEY=
# CPA 超时(秒): 请求 CPA 管理接口的超时时间
CPA_REQUEST_TIMEOUT=
# 保存CPA回执: CPA 未返回完整授权文件时，本地仍保存一份回调提交记录
CPA_SAVE_CALLBACK_RECEIPT=

# ---- 接码平台 ----
# 接码通道: grizzly / l / h；h 使用 H_API.md 定义的本地取号服务
SMS_PROVIDER=
# 国家代码: 传给接码平台的 country；GrizzlySMS 常用：美国=187；L/H 通道按本地后台配置填写
SMS_COUNTRY=
# 服务/项目代码: GrizzlySMS/L 作为 service；H 通道可复用为 projectId
SMS_SERVICE=
# 换号重试次数: 一个号收不到短信/被OpenAI拒时换下一个号，最多重试几次
SMS_MAX_RETRIES=
# 单号等短信(秒): 单个号等待短信到达的最长秒数，超时则换号
SMS_CODE_WAIT=
# GrizzlySMS API密钥: 保存在 .env（SMS_API_KEY），不写回 config/*.py
SMS_API_KEY=
# H API 地址: H 取号服务基础地址，例如 http://localhost:8788
H_API_BASE=
# H 授权码: 保存在 .env（H_ADMIN_AUTH_CODE），不写回 config/*.py
H_ADMIN_AUTH_CODE=
# H 号码前缀: H 返回号码不含国家码时填写，例如美国 10 位本地号填 1；留空则不补
H_PHONE_PREFIX=
# H 取号方式: reusable=优先复用号码；new=每次取新号（调用 /api/admin/h/take-phone）
H_PHONE_ACQUIRE_MODE=
# L API 地址: L 取号服务基础地址，例如 http://localhost:8788
L_API_BASE=
# L 授权码: 保存在 .env（L_ADMIN_AUTH_CODE），不写回 config/*.py
L_ADMIN_AUTH_CODE=
# L 号码前缀: L 返回号码不含国家码时填写，例如美国 10 位本地号填 1；留空则不补
L_PHONE_PREFIX=
